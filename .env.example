# Resend API key — used by src/app/api/contact/route.ts to send contact-form emails.
# Get one at https://resend.com/api-keys (free tier is enough for a portfolio contact form).
# Locally: copy this file to .env.local and fill in the real value (never commit .env.local).
# On Vercel: add it under Project Settings → Environment Variables.
RESEND_API_KEY=

# Optional. Who contact-form mail is delivered to. Defaults to siteConfig.email.
#
# IMPORTANT: while you are using Resend's shared sandbox sender
# (onboarding@resend.dev), Resend will ONLY deliver to the email address that
# owns the Resend account. If that address differs from siteConfig.email, every
# send fails with a 502 until you either set this to your Resend account address
# or verify your own domain.
CONTACT_TO_EMAIL=

# Optional. The From address. Defaults to "Portfolio Contact <onboarding@resend.dev>".
# Once you verify a domain at https://resend.com/domains, set this to an address
# on it (e.g. "Portfolio <hello@yourdomain.com>") — that lifts the sandbox
# restriction above and improves deliverability.
CONTACT_FROM_EMAIL=
